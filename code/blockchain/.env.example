# Copy to .env and fill in values for the environment you're deploying to.
# NEVER commit .env or a real private key to version control.
#
# Not needed for `npx hardhat compile` / `npx hardhat test` - those always
# run against the in-process "hardhat" network. Only needed for
# `npx hardhat run scripts/deploy.js --network <localhost|testnet|mainnet>`.

# Account that pays gas and receives DEFAULT_ADMIN_ROLE on the deployed
# contracts for testnet/mainnet deploys (unused on localhost, which uses
# Hardhat's built-in funded accounts instead).
DEPLOYER_PRIVATE_KEY=

# Testnet (defaults to Sepolia, chain ID 11155111)
TESTNET_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
TESTNET_CHAIN_ID=11155111

# Mainnet
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# Only needed if your local node isn't at the Hardhat default.
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# Chainlink CCIP router address for CrossChainManager on the target network
# (see https://docs.chain.link/ccip/directory). If unset, deploy.js deploys
# a MockCCIPRouter instead so the script still runs end-to-end locally.
CCIP_ROUTER_ADDRESS=

# Addresses used for InstitutionalDeFiProtocol's treasury/insurance funds.
# Defaults to the deployed AssetVault address when unset.
TREASURY_ADDRESS=
INSURANCE_ADDRESS=
PRICE_ORACLE_ADDRESS=
